<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Views.CalculatorPage"
             xmlns:vm="clr-namespace:ViewModels"
             x:DataType="vm:CalculatorViewModel"
             Title="{Binding Title}"                  
             Shell.FlyoutBehavior="Disabled">
    
    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="{Binding Title}"
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- תיבות קלט למספרים -->
        <Entry Text="{Binding Num1}" 
               Placeholder="הכנס מספר ראשון" 
               Keyboard="Numeric" 
               HeightRequest="48" />

        <Entry Text="{Binding Num2}" 
               Placeholder="הכנס מספר שני" 
               Keyboard="Numeric" 
               HeightRequest="48" />

        <!-- כפתורי פעולות החשבון -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" HeightRequest="50">
            <Button Grid.Column="0" Text="+" Command="{Binding AddCommand}" Clicked="" FontSize="20" />
            <Button Grid.Column="1" Text="-" Command="{Binding SubtractCommand}"  FontSize="20" />
            <Button Grid.Column="2" Text="*" Command="{Binding MultiplyCommand}"  FontSize="20" />
            <Button Grid.Column="3" Text="/" Command="{Binding DivideCommand}" FontSize="20" />
        </Grid>
        
        <!-- הצגת התוצאה באמצעות Border המודרני -->
        <Border BackgroundColor="#F0F0F0" Padding="15" Margin="0,10,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="התוצאה היא:" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Bindint Result}" Text="0" FontSize="20" FontAttributes="Bold" TextColor="Green" />
            </HorizontalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>